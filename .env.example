# Required: the Base64 credential copied from Inworld Settings > API Keys.
INWORLD_API_KEY=

# Twilio Account SID identifies the account; it is not the secret Auth Token.
TWILIO_ACCOUNT_SID=

# Optional: credentials for Twilio REST API calls. These do not replace the
# Account Auth Token used for webhook-signature validation.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Required: Twilio Console > Account Info > Auth Token.
TWILIO_AUTH_TOKEN=

# Required: the public HTTPS origin that Twilio can reach, without a trailing slash.
# Example: https://stt.example.com
PUBLIC_BASE_URL=

# Optional.
PORT=8080
STT_LANGUAGE=en-US
INWORLD_TTS_MODEL=inworld-tts-2
INWORLD_TTS_SPONSOR_VOICE=Dennis
INWORLD_TTS_AGENT_VOICE=Ashley

# Optional: receive each partial/final transcript as an HTTP POST.
TRANSCRIPT_WEBHOOK_URL=
TRANSCRIPT_WEBHOOK_BEARER=

# Optional: normalized JSON product catalog and maximum sponsored placements per call.
PRODUCT_CATALOG_PATH=data/products/brightdata-amazon-2026-08-01.products.json
AD_FREQUENCY_CAP=2

# Recommended in production: bearer token required by POST /ads/select.
AD_API_BEARER=

# demo: Twilio speech capture + spoken ad injection. stream: raw audio to Inworld STT.
VOICE_MODE=demo

# Optional wholesale LLM response service. The phone demo falls back safely when unavailable.
WHOLESALE_AGENT_URL=http://127.0.0.1:8000
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
CLAUDE_MODEL=claude-haiku-4-5
MAX_TOKENS=1024
