# === Voice gateway (Node) ===

# Required: Base64 credential from Inworld Settings > API Keys (used for STT + TTS).
INWORLD_API_KEY=

# The wholesale sales agent (FastAPI) the voice loop talks to.
WHOLESALE_AGENT_URL=http://127.0.0.1:8000

# Optional voice-gateway tuning.
PORT=8080
STT_LANGUAGE=en-US
INWORLD_TTS_MODEL=inworld-tts-2
INWORLD_TTS_AGENT_VOICE=Ashley

# Optional: also accept Twilio phone-call audio for STT (no ad injection).
# Leave TWILIO_AUTH_TOKEN empty to disable the Twilio path entirely.
TWILIO_AUTH_TOKEN=
PUBLIC_BASE_URL=
TRANSCRIPT_WEBHOOK_URL=
TRANSCRIPT_WEBHOOK_BEARER=

# === Wholesale sales agent (FastAPI, via docker-compose) ===

# Provide your Claude key to enable agent turns. Use claude-sonnet-5 (balanced)
# or claude-haiku-4-5 (cheapest/fastest).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
MAX_TOKENS=4096
